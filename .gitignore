# Ignore everything by default.
*

# Top-level dotfiles and manifests.
!.gitignore
!.gitattributes
!.editorconfig
!README.md
!.bash_profile
!.bashrc
!.inputrc
!.zshrc
!bootstrap.ps1
!check.ps1
!scoop.json

# Small user-facing executables shipped with the dotfiles.
!.local/
!.local/bin/
!.local/bin/dotfiles-doctor

# Selected config files and directories.
!.config/

!.config/bash/
!.config/bash/*
.config/bash/99-local.bash
.config/bash/01-local.bash
.config/bash/local.bash
!.config/bash/docs/generated/
!.config/bash/docs/generated/*
!.config/bash/docs/cheatsheet.md

!.config/helix
!.config/helix/*
!.config/helix/themes
!.config/helix/themes/*

!.config/nvim/
!.config/nvim/**

!.config/starship.toml

!.config/wezterm/
!.config/wezterm/*

!.config/winfetch/
!.config/winfetch/*

# Local secrets.
.env
*.secret
